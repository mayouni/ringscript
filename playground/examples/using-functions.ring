one() two() three()
? sum(10,10)

message() anotherMessage()

func one   ? :one 
func two   ? :two 
func three ? :three

# We can use braces
func sum(x,y) {
    return x+y
}

# We can use end|endfunction
def message 
    ? "I Love Programming!"
end

function anotherMessage() 
    ? "What about you?"
endfunction 
